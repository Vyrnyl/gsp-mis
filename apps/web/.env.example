# Copy to apps/web/.env.local if you need to override a default. Never commit the real file.

# Origin of the Express API (apps/api) that the BFF route handlers under
# src/app/api/auth/ call server-to-server, and that next.config.mjs rewrites
# /api/v1/:path* to. Defaults to the local dev API — override only when the
# API is not running on localhost:4000.
API_ORIGIN=http://localhost:4000
