# Copy to apps/api/.env and fill in. Never commit the real .env.
# Every value below is validated on boot by src/config/env.ts — the process
# refuses to start if any is missing or too short.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Used by the node-postgres driver adapter at runtime
# (src/config/prisma.ts) and by Migrate via prisma.config.ts.
#
# For a hosted database (Neon, Supabase, RDS) prefer `sslmode=verify-full` over
# `sslmode=require`. node-postgres currently treats them the same, but pg v9 will
# downgrade `require` to weaker libpq semantics that skip certificate verification.
# Being explicit now keeps the stronger behaviour and silences the deprecation warning.
#   Neon example:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=verify-full&channel_binding=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gsp_mis?schema=public"

# Optional — direct, UNPOOLED connection used by Prisma Migrate only (see prisma.config.ts).
# Leave unset locally: it falls back to DATABASE_URL, which is correct for a plain postgres.
#
# Set it wherever DATABASE_URL points at a transaction-mode pooler (Neon's `-pooler` host,
# PgBouncer, Supabase port 6543). Migrate holds a session-level advisory lock across
# statements, which such a pooler cannot honour, so `prisma migrate deploy` fails with
# `P1002 … Timed out trying to acquire a postgres advisory lock` after a hard-coded 10s.
# For Neon, take DATABASE_URL and drop `-pooler` from the hostname:
#   DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=verify-full"

# Auth secrets — minimum 32 characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-48-byte-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-byte-random-string"
COOKIE_SECRET="replace-me-with-another-48-byte-random-string-value"

JWT_EXPIRES_IN=3h
JWT_REFRESH_EXPIRES_IN=7d

# Origins permitted to call the API. The BFF (Next.js) is the only client in v1.
CORS_ORIGINS=http://localhost:3000

# Required to complete Admin signup — the frontend's "Admin Secret Key" field must match
# this exactly. Distribute out-of-band (e.g. from the national office), never commit it.
ADMIN_SIGNUP_KEY="replace-me-with-an-internal-admin-onboarding-key"

# Shared EmailService (src/shared/utils/email.ts). All optional — leave unset in dev/test
# and outgoing emails are logged to the console instead of sent.
#
# Option A — the Gmail API over HTTPS (checked first if all three are set). Sends as a
# real Gmail account, so — unlike Option B below — it can reach any recipient, not just
# the account owner, and — unlike Option C — it isn't affected by hosts (Render's free
# plan included) that silently drop outbound SMTP traffic. One-time setup:
#   1. console.cloud.google.com -> new project -> enable the "Gmail API".
#   2. APIs & Services > OAuth consent screen -> External -> add the sending Gmail
#      account as a test user (or publish the app) -> add the
#      https://www.googleapis.com/auth/gmail.send scope.
#   3. APIs & Services > Credentials -> Create OAuth client ID -> type "Desktop app" ->
#      note the client ID and secret.
#   4. Generate a one-time refresh token for the sending account using those
#      credentials and the OAuth2 Playground (https://developers.google.com/oauthplayground):
#      gear icon -> "Use your own OAuth credentials" -> paste client ID/secret -> select
#      the Gmail API v1 "https://www.googleapis.com/auth/gmail.send" scope -> Authorize
#      (sign in as the sending account) -> Exchange authorization code for tokens -> copy
#      the refresh token shown.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
#
# Option B — Mailtrap's HTTP API (checked next if set). Get a token from
# https://mailtrap.io (Settings > API Tokens). If sending through Mailtrap's shared demo
# domain (no verified domain of your own), EMAIL_FROM's address must be
# hello@demomailtrap.co — Mailtrap only delivers demo-domain mail to your own verified
# account email; sending to arbitrary recipients needs your own verified sending domain.
MAILTRAP_API_TOKEN=
#
# Option C — real SMTP (works with any provider: Gmail, SendGrid, SES SMTP, ...), used
# only if neither of the above is set. Some hosts (Render's free plan included) silently
# drop outbound SMTP traffic rather than refusing it, so this can hang/fail when deployed
# even though it works fine locally — prefer Option A or B when deploying.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# Used as the From header by all three options. For Option A, the address portion must
# be the sending Gmail account's own address (or one of its verified "Send As" aliases)
# — Gmail silently rewrites any other address to the authenticated account's own.
EMAIL_FROM="Girl Scouts of the Philippines <no-reply@gsp-mis.local>"

# Base URL of the web app — used to build links inside outgoing emails (password reset, etc).
WEB_APP_URL=http://localhost:3000
