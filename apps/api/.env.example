# Copy to apps/api/.env and fill in. Never commit the real .env.
# Every value below is validated on boot by src/config/env.ts — the process
# refuses to start if any is missing or too short.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Used by the node-postgres driver adapter at runtime
# (src/config/prisma.ts) and by Migrate via prisma.config.ts.
#
# For a hosted database (Neon, Supabase, RDS) prefer `sslmode=verify-full` over
# `sslmode=require`. node-postgres currently treats them the same, but pg v9 will
# downgrade `require` to weaker libpq semantics that skip certificate verification.
# Being explicit now keeps the stronger behaviour and silences the deprecation warning.
#   Neon example:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=verify-full&channel_binding=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gsp_mis?schema=public"

# Auth secrets — minimum 32 characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-48-byte-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-byte-random-string"
COOKIE_SECRET="replace-me-with-another-48-byte-random-string-value"

JWT_EXPIRES_IN=3h
JWT_REFRESH_EXPIRES_IN=7d

# Origins permitted to call the API. The BFF (Next.js) is the only client in v1.
CORS_ORIGINS=http://localhost:3000

# Required to complete Admin signup — the frontend's "Admin Secret Key" field must match
# this exactly. Distribute out-of-band (e.g. from the national office), never commit it.
ADMIN_SIGNUP_KEY="replace-me-with-an-internal-admin-onboarding-key"

# Shared EmailService (src/shared/utils/email.ts). All optional — leave unset in dev/test
# and outgoing emails are logged to the console instead of sent.
#
# Option A — Mailtrap's HTTP API (checked first if set). Get a token from
# https://mailtrap.io (Settings > API Tokens). If sending through Mailtrap's shared demo
# domain (no verified domain of your own), EMAIL_FROM's address must be
# hello@demomailtrap.co — Mailtrap only delivers demo-domain mail to your own verified
# account email.
MAILTRAP_API_TOKEN=
#
# Option B — real SMTP (works with any provider: Gmail, SendGrid, SES SMTP, ...), used
# only if MAILTRAP_API_TOKEN is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Girl Scouts of the Philippines <no-reply@gsp-mis.local>"

# Base URL of the web app — used to build links inside outgoing emails (password reset, etc).
WEB_APP_URL=http://localhost:3000
